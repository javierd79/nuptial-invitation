# Firma la cookie de sesión del panel. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Almacenamiento de datos. Sin esto se usa data/*.json en disco.
# Defínelo solo en Vercel: https://vercel.com/<tu-proyecto>/stores/blob
BLOB_READ_WRITE_TOKEN=

# Fuerza el driver de almacenamiento: "json" | "blob". Opcional.
# DATA_DRIVER=json

# Solo para `bun run export` (migración desde Supabase). Bórralas después.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
